"Veja a documentação do comando de menu <link linkend=\"gimp-layer-alpha-"
"selection-replace\">Alfa para seleção</link>."

#: src/dialogs/layer-dialog.xml:1154(term)
msgid "Merge Visible Layers"
msgstr "Combinar camadas visíveis"

#: src/dialogs/layer-dialog.xml:1156(para)
msgid "This command merges all visible layers into one layer."
msgstr "Este comando combina todas as camadas visíveis em uma só camada."

#: src/dialogs/layer-dialog.xml:1162(term)
msgid "Flatten Image"
msgstr "Achatar imagem"

#: src/dialogs/layer-dialog.xml:1164(para)
msgid ""
"This command merges all layers into one layer and removes transparency."
msgstr ""
"Este comando combina todas as camadas em uma só camada e remove a "
"transparência."

