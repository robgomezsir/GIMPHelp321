#: src/dialogs/file-jp2-export.xml:54(para)
#: src/dialogs/common-metadata-settings.xml:19(para)
#| msgid ""
#| "You can click the <quote>(edit)</quote> link to open the metadata editor to "
#| "change or add any metadata that you want to be included in the image. Note: "
#| "you will also still need to enable the relevant metadata saving options "
#| "listed below."
msgid ""
"You can click the <quote>(edit)</quote> link to open the <link "
"linkend=\"plug-in-metadata-editor\">metadata editor</link> to change or add "
"any metadata that you want to be included in the image. Note: you will also "
"still need to enable the relevant metadata saving options listed below."
msgstr ""
"Você pode clicar no link <quote>(editar)</quote> para abrir o <link "
"linkend=\"plug-in-metadata-editor\">editor de metadados</link> e alterar ou "
"adicionar qualquer metadado que queira incluir na imagem. Observação: você "
"ainda precisará ativar as opções de salvamento de metadados relevantes "
"listadas abaixo."

#: src/dialogs/file-jp2-export.xml:61(para)
