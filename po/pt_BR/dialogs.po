#: src/dialogs/layer-dialog.xml:1122(term)
#| msgid "Layer mask"
msgid "Edit Layer Mask"
msgstr "Editar máscara de camada"

#: src/dialogs/layer-dialog.xml:1123(term)
#| msgid "Layer masks"
