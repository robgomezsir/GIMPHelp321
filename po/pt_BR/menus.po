#: src/menus/tools.xml:21(para)
#| msgid ""
#| "The menu entries on the <guimenu>Tools</guimenu> menu access the "
#| "<acronym>GIMP</acronym> tools. All of the tools available in "
#| "<acronym>GIMP</acronym> are extensively described in the <link "
#| "linkend=\"gimp-tools\">Tools</link> section."
msgid ""
"All of the tools available in <acronym>GIMP</acronym> are extensively "
"described in the <link linkend=\"gimp-tools\">Tools</link> section."
msgstr ""
"Todas as ferramentas disponíveis no <acronym>GIMP</acronym> são descritas "
"detalhadamente na seção <link linkend=\"gimp-tools\">Ferramentas</link>."

