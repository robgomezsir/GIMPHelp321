#: src/filters/distort/video-degradation.xml:50(para)
#| msgid ""
#| "This filter is found in the image window menu under "
#| "<menuchoice><guimenu>Filters</guimenu><guisubmenu>Distorts</guisubmenu><guimenuitem>Lens"
