#: src/filters/distort/ripple.xml:8(title)
#: src/filters/distort/ripple.xml:13(tertiary)
msgid "Ripple"
msgstr "Ondulações"

#: src/filters/distort/ripple.xml:16(primary)
msgid "Ripple filter"
msgstr "Filtro Ondulações"

#: src/filters/distort/ripple.xml:22(title)
msgid "<quote>Ripple</quote> filter example"
msgstr "Exemplo do filtro <quote>Ondulações</quote>"

#: src/filters/distort/ripple.xml:42(para)
msgid ""
"It displaces the pixels of the active layer or selection to waves or ripples"
" reminding a reflection on disturbed water."
msgstr ""
"Move os pixels da camada ou seleção ativa na forma de ondas ou ondulações, "
"lembrando um reflexo em águas agitadas."

#: src/filters/distort/ripple.xml:50(para)
#| msgid ""
#| "This filter is found in the image window menu under "
#| "<menuchoice><guimenu>Filters</guimenu><guisubmenu>Distorts</guisubmenu><guimenuitem>Engrave</guimenuitem></menuchoice>."
msgid ""
"This filter is found in the main menu under "
"<menuchoice><guimenu>Filters</guimenu><guisubmenu>Distorts</guisubmenu><guimenuitem>Ripple…</guimenuitem></menuchoice>."
msgstr ""
"Esse filtro pode ser encontrado no menu da janela de imagens em "
"<menuchoice><guimenu>Filtros</guimenu><guisubmenu>Distorções</guisubmenu><guimenuitem>Entalhar</guimenuitem></menuchoice>"

#: src/filters/distort/ripple.xml:63(title)
msgid "<quote>Ripple</quote> filter options"
msgstr "Opções do filtro <quote>Ondulações</quote>"

#: src/filters/distort/ripple.xml:85(term)
#| msgid "Original image"
msgid "Original images for examples"
msgstr "Imagens originais para os exemplos"

#: src/filters/distort/ripple.xml:110(para)
msgid "It is related to wave height (0-200 pixels)."
msgstr ""
"Se relaciona com a altura da onda (0 - 200 pixels): quanto cada pixel vai se"
" deslocar nos pontos de intensidade máxima da onda."

#: src/filters/distort/ripple.xml:119(para)
#| msgid "Amplitude"
msgid "Amplitude = 25"
msgstr "Amplitude = 25"

#: src/filters/distort/ripple.xml:129(para)
msgid "It is related to wavelength (0-200 pixels)"
msgstr "Se relaciona ao comprimento de onda (0 - 200 pixels)"

#: src/filters/distort/ripple.xml:138(para)
#| msgid "Period"
msgid "Period = 110"
msgstr "Período = 110"

#: src/filters/distort/ripple.xml:148(para)
msgid "Wave is moved"
msgstr "A onda é movida"

#: src/filters/distort/ripple.xml:157(para)
#| msgid "Phase shift"
msgid "Phase shift = 0.400"
msgstr "Deslocamento de fase = 0,400"

#: src/filters/distort/ripple.xml:165(term)
#: src/filters/distort/newsprint.xml:162(term)
msgid "Angle"
msgstr "Ângulo"

#: src/filters/distort/ripple.xml:167(para)
msgid "Warps wave"
msgstr "Deforma a onda"

#: src/filters/distort/ripple.xml:176(para)
msgid "Angle = -40°"
msgstr "Ângulo = -40°"

#: src/filters/distort/ripple.xml:193(term)
#| msgid "Wave Type"
msgid "Wave type"
msgstr "Tipo de onda"

#: src/filters/distort/ripple.xml:195(para)
msgid "Choose how the wave should look like:"
msgstr "Escolhe como a onda deve ser:"

#: src/filters/distort/ripple.xml:201(guilabel)
msgid "Sawtooth"
msgstr "Dente de serra"

#: src/filters/distort/ripple.xml:206(guilabel)
#| msgid "Triangles"
msgid "Triangle"
msgstr "Triângulos"

#: src/filters/distort/ripple.xml:211(guilabel)
msgid "Sine"
msgstr "Seno"

#: src/filters/distort/ripple.xml:218(term)
msgid "Abyss policy"
msgstr "Política do Abismo"

#: src/filters/distort/ripple.xml:220(para)
msgid ""
"Because ripples cause pixel displacement, some pixels may be missing on the "
"image sides:"
msgstr ""
"Como as ondulações deslocam os pixels, alguns pixels podem ficar faltando "
"nas bordas da imagem:"

#: src/filters/distort/ripple.xml:230(para)
msgid "Abyss policy = Black"
msgstr "Política de borda = Preto"

#: src/filters/distort/ripple.xml:235(para)
msgid ""
"Abyss policy (border management) is treated with <xref linkend=\"abyss-"
"policy\"/>."
msgstr ""
"Política do Abismo (gerenciamento de bordas) é tratada com <xref "
"linkend=\"abyss-policy\"/>."

#: src/filters/distort/ripple.xml:242(term)
msgid "Tileable"
msgstr "Encaixável"

#: src/filters/distort/ripple.xml:244(para)
msgid ""
"This preserves the seamless properties if your image is a tile pattern."
msgstr ""
"Esta opção mantem sua imagem encaixável com cópias dela mesma dos lados (sem"
" perceber as bordas), se sua imagem já tiver essa propriedade."

