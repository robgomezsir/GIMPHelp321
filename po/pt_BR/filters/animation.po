#: src/filters/animation/playback.xml:13(title)
#: src/filters/animation/playback.xml:15(anchor:xreflabel)
#: src/filters/animation/playback.xml:19(tertiary)
#: src/filters/animation/playback.xml:23(secondary)
#: src/filters/animation/playback.xml:26(primary)
msgid "Playback"
msgstr "Reproduzir"

#: src/filters/animation/playback.xml:31(para)
msgid ""
"This plug-in lets you play an animation from a multi-layers image. "
"<acronym>GIMP</acronym> supports several formats that allow you to export an"
" <link linkend=\"gimp-exporting-animations\">animation</link>, e.g. <link "
"linkend=\"file-webp-export\">webp</link>, <link linkend=\"file-gif-"
"export\">gif</link> and <link linkend=\"file-mng-export\">mng</link>. In "
"addition to that, GIMP supports loading (but at this time not exporting) "
"apng images. Regular multi-layer formats like GIMP's own XCF as well as PSD,"
" TIFF and PSP also allow you to use multiple layers that can be interpreted "
"by this animation player as an animation."
msgstr ""
"Este plug-in permite reproduzir uma animação de uma imagem com várias "
"camadas. O <acronym>GIMP</acronym> suporta vários formatos que permitem "
"exportar uma <link linkend=\"gimp-exporting-animations\">animação</link>, "
"por exemplo <link linkend=\"file-webp-export\">webp</link>, <link "
"linkend=\"file-gif-export\">gif</link> e <link linkend=\"file-mng-"
"export\">mng</link>. Além disso, o GIMP suporta carregar (mas no momento não"
" exportar) imagens apng. Formatos comuns de várias camadas, como o próprio "
"XCF do GIMP, bem como PSD, TIFF e PSP, também permitem usar várias camadas "
"que podem ser interpretadas por este player de animação como uma animação."

#: src/filters/animation/playback.xml:48(para)
#| msgid ""
#| "This filter is found in the image window menu under "
#| "<menuchoice><guimenu>Filters</guimenu><guisubmenu>Animation</guisubmenu><guimenuitem>Waves</guimenuitem></menuchoice>."
msgid ""
"This filter is found in the main menu under "
"<menuchoice><guimenu>Filters</guimenu><guisubmenu>Animation</guisubmenu><guimenuitem>Playback…</guimenuitem></menuchoice>."
msgstr ""
"Este filtro é encontrado no menu da janela de "
"imagem<menuchoice><guimenu>Filtros</guimenu><guisubmenu>Animação</guisubmenu><guimenuitem>Ondas</guimenuitem></menuchoice>."

#: src/filters/animation/playback.xml:61(title)
msgid "<quote>Playback</quote> filter options"
msgstr "opções do filtro <quote>Reproduzir</quote> "

#: src/filters/animation/playback.xml:69(para)
msgid "This dialog has:"
msgstr "Este diálogo possui:"

#: src/filters/animation/playback.xml:72(term)
msgid "Preview"
msgstr "Pré-visualização"

#: src/filters/animation/playback.xml:74(para)
#| msgid ""
#| "This preview of the animation automatically fits the frame size. The number "
#| "of the displayed frame is shown below the preview."
msgid ""
"The center of the Playback dialog is taken up by a preview of the animation "
"that automatically fits to the frame size. The number of the displayed frame"
" as well as the total number of frames is shown below the preview next to "
"the player controls."
msgstr ""
"O centro da caixa de diálogo Reprodução é ocupado por uma pré-visualização "
"da animação que se ajusta automaticamente ao tamanho do quadro. O número do "
"quadro exibido, bem como o número total de quadros, é mostrado abaixo da "
"pré-visualização, ao lado dos controles do player."

#: src/filters/animation/playback.xml:83(term)
msgid "Drop-down lists at the top"
msgstr "Listas suspensas na parte superior"

#: src/filters/animation/playback.xml:85(para)
msgid ""
"The following drop-down lists and controls are available above the preview:"
msgstr ""
"As seguintes listas suspensas e controles estão disponíveis acima da pré-"
"visualização:"

#: src/filters/animation/playback.xml:91(term)
msgid "Combine/Replace layers"
msgstr "Combinar/Substituir camadas"

#: src/filters/animation/playback.xml:93(para)
msgid ""
"This can be <guibutton>Cumulative layers (combine)</guibutton> to show all "
"frames so far on top of each other, or <guibutton>One frame per layer "
"(replace)</guibutton> to show only the last frame."
msgstr ""
"Isto pode ser <guibutton>Camadas cumulativas (combinar)</guibutton>, para "
"mostrar todos os quadros até agora uns sobre os outros, ou <guibutton>Um "
"quadro por camada (substituir)</guibutton>, para mostrar apenas o último "
"quadro."

#: src/filters/animation/playback.xml:102(term)
msgid "Default framerate"
msgstr "Taxa de quadros padrão"

#: src/filters/animation/playback.xml:104(para)
msgid ""
"This allows you to set the number of frames per second used when playing the"
" animation."
msgstr ""
"Isto permite definir o número de quadros por segundo usado ao reproduzir a "
"animação."

#: src/filters/animation/playback.xml:111(term)
#| msgid "Playback"
msgid "Playback speed"
msgstr "Velocidade de reprodução"

#: src/filters/animation/playback.xml:113(para)
msgid "This allows you to set the speed of the animation."
msgstr "Isto permite definir a velocidade da animação."

#: src/filters/animation/playback.xml:119(term)
msgid "Zoom"
msgstr "Zoom"

#: src/filters/animation/playback.xml:121(para)
msgid "This allows you to set the zoom level of the animation."
msgstr "Isto permite definir o nível de zoom da animação."

#: src/filters/animation/playback.xml:131(term)
msgid "Player Controls at the top right"
msgstr "Controles do player no canto superior direito"

#: src/filters/animation/playback.xml:135(term)
msgid "<placeholder-1/> Reload the image"
msgstr "<placeholder-1/> Recarregar a imagem"

#: src/filters/animation/playback.xml:148(para)
msgid "This loads the animation again, useful if changes have been made."
msgstr ""
"Isto carrega a animação novamente, útil se alterações tiverem sido feitas."

#: src/filters/animation/playback.xml:155(term)
