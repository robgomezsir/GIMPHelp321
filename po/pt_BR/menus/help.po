#: src/menus/help/search-and-run.xml:5(title)
#: src/menus/help/search-and-run.xml:9(secondary)
#: src/menus/help/search-and-run.xml:12(primary)
msgid "Search and Run a Command"
msgstr "Pesquisar e executar um comando"

#: src/menus/help/search-and-run.xml:15(para)
msgid ""
"The <guimenuitem>Search and Run a Command</guimenuitem> displays a dialog "
"where you can search for all commands that are available in GIMP, even those"
" that are not part of the menu. It is a quick and easy way to start a "
"command if you don't know exactly where to find it."
msgstr ""
"O <guimenuitem>Pesquisar e executar um comando</guimenuitem> exibe uma caixa"
" de diálogo em que você pode pesquisar todos os comandos disponíveis no "
"GIMP, mesmo os que não fazem parte do menu. É uma forma rápida e fácil de "
"iniciar um comando quando você não sabe exatamente onde encontrá-lo."

#: src/menus/help/search-and-run.xml:25(para)
#| msgid ""
#| "You can access this command from the image menu through "
#| "<menuchoice><guimenu>Help</guimenu><guimenuitem>Context "
#| "Help</guimenuitem></menuchoice>"
msgid ""
"You can access this command from the main menu through "
"<menuchoice><guimenu>Help</guimenu><guimenuitem>Search and Run a "
"Command</guimenuitem></menuchoice>."
msgstr ""
"Você pode acessar este comando pelo menu da janela de imagem através de "
"<menuchoice><guimenu>Ajuda</guimenu><guimenuitem>Ajuda por "
"contexto</guimenuitem></menuchoice>"

#: src/menus/help/search-and-run.xml:35(title)
#| msgid "Description of the dialog window"
msgid "Description of the dialog"
msgstr "Descrição da janela de dicas"

#: src/menus/help/search-and-run.xml:37(title)
msgid "<quote>Search and Run a Command</quote> window"
msgstr "Janela <quote>Pesquisar e executar um comando</quote>"

#: src/menus/help/search-and-run.xml:46(para)
msgid ""
"When you have not entered any search text yet, this window will be empty. As"
" soon as you start typing, GIMP will show all commands that contain the "
"search phrase you entered."
msgstr ""
"Quando você ainda não digitou nenhum texto de pesquisa, esta janela fica "
"vazia. Assim que você começa a digitar, o GIMP mostra todos os comandos que "
"contêm a frase pesquisada."

#: src/menus/help/search-and-run.xml:51(para)
msgid ""
"When you see the command that you are looking for in the list, you can "
"double click on that command to start it."
msgstr ""
"Quando você vir na lista o comando que procura, pode clicar duas vezes nele "
"para iniciá-lo."

