"<menuchoice><guimenu>Layers</guimenu><guisubmenu>Stack</guisubmenu><guimenuitem>Reverse"
" Layer Order</guimenuitem></menuchoice>."
msgstr ""
"Você pode acessar este comando a partir do menu "
"<menuchoice><guimenu>Camada</guimenu><guisubmenu>Pilha</guisubmenu><guimenuitem>Subir"
" camada</guimenuitem></menuchoice>,"

