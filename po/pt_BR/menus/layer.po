"<menuchoice><guimenu>Layer</guimenu><guisubmenu>Transform</guisubmenu><guimenuitem>Arbitrary"
" Rotation</guimenuitem></menuchoice>."
msgstr ""
"Você pode acessar este comando a partir do menu "
"<menuchoice><guimenu>Camada</guimenu><guisubmenu>Transformar</guisubmenu><guimenuitem>Rotação"
" Livre</guimenuitem></menuchoice>,"

