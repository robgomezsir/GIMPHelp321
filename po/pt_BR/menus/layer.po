"<menuchoice><guimenu>Layer</guimenu><guisubmenu>Transform</guisubmenu><guimenuitem>Rotate"
" 90° clockwise</guimenuitem></menuchoice>."
msgstr ""
"Você pode acessar este comando a partir do menu "
"<menuchoice><guimenu>Camada</guimenu><guisubmenu>Transformar</guisubmenu><guimenuitem>Rotacionar"
" 90° horário</guimenuitem></menuchoice>."

