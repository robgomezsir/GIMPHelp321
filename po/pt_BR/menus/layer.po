"<menuchoice><guimenu>Layer</guimenu><guisubmenu>Mask</guisubmenu><guimenuitem>Intersect"
" Masks with Selection</guimenuitem></menuchoice>."
msgstr ""
"Você pode acessar este comando a partir do menu "
"<menuchoice><guimenu>Camada</guimenu><guisubmenu>Máscara</guisubmenu><guimenuitem>Fazer"
" intersecção com a seleção</guimenuitem></menuchoice>."

