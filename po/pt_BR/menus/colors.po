#: src/menus/colors/linear-invert.xml:16(primary)
msgid "Linear Invert colors"
msgstr "Inversão Linear de cores"

#: src/menus/colors/linear-invert.xml:19(para)
msgid ""
"The <guimenuitem>Linear Invert</guimenuitem> command inverts all the color "
"components except the alpha channel in the current layer in linear light. "
"Dark areas become bright and bright areas become dark."
msgstr ""
"O comando <guimenuitem>Inversão Linear</guimenuitem> inverte todos os "
"componentes de cor, exceto o canal alfa, na camada atual em luz linear. "
"Áreas escuras se tornam claras e áreas claras se tornam escuras."

#: src/menus/colors/linear-invert.xml:26(para)
#: src/menus/colors/invert.xml:32(para)
msgid ""
"Do not confuse this command with the <link linkend=\"gimp-selection-"
"invert\">Invert Selection</link> command."
msgstr ""
"Não confunda este comando com o comando de <link linkend=\"gimp-selection-"
"invert\">Inverter seleção</link>."

