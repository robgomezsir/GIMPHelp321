#: src/menus/colors/hot.xml:17(secondary) src/menus/colors/hot.xml:20(primary)
msgid "Hot"
msgstr "Quente"

#: src/menus/colors/hot.xml:25(para)
msgid ""
"This command identifies and modifies pixels which might cause problems when "
"displayed on PAL or NTSC TV screens."
msgstr ""
"Este comando identifica e modifica pixels que poderiam causar problemas "
"quando exibidos em uma tela de TV PAL ou NTSC."

#: src/menus/colors/hot.xml:33(para)
#| msgid ""
#| "You can access this command from the image menubar through "
#| "<menuchoice><guimenu>Colors</guimenu><guimenuitem>Hue-"
#| "Chroma…</guimenuitem></menuchoice>."
msgid ""
"You can access this command from the main menu through "
"<menuchoice><guimenu>Colors</guimenu><guimenuitem>Hot…</guimenuitem></menuchoice>."
msgstr ""
"Você pode acessar este na barra de menu da imagem em "
"<menuchoice><guimenu>Cores</guimenu><guimenuitem>Matiz-"
"Croma...</guimenuitem></menuchoice>."

#: src/menus/colors/hot.xml:41(para)
msgid ""
"This command only works on images in RGB mode, and only if the active layer "
"does not have an alpha channel. Otherwise the command is disabled."
msgstr ""
"Este comando só funciona em imagens no modo RGB, e somente se a camada ativa"
" não tiver um canal alfa. Se não, o comando será desabilitado."

#: src/menus/colors/hot.xml:52(title)
msgid "<quote>Hot</quote> options"
msgstr "Opções do <quote>Quente</quote>"

#: src/menus/colors/hot.xml:62(term)
msgid "Mode"
msgstr "Modo"

#: src/menus/colors/hot.xml:64(para)
#| msgid "You have to select the TV mode: PAL or NTSC."
msgid ""
"You have to select the TV mode: <guilabel>PAL</guilabel> or "
"<guilabel>NTSC</guilabel>."
msgstr ""
"Você precisa selecionar o modo de TV: <guilabel>PAL</guilabel> ou "
"<guilabel>NTSC</guilabel>."

#: src/menus/colors/hot.xml:71(term)
msgid "Action"
msgstr "Ação"

#: src/menus/colors/hot.xml:73(para)
msgid "Here you can select the method used to remove hot pixels."
msgstr ""
"Aqui você pode selecionar o método usado para remover os pixels quentes."

# ** EEEk : Luminancy. (searching for Luminency on google to check if the term
# actually exists is fun, though)
#: src/menus/colors/hot.xml:78(term)
msgid "Reduce Luminance"
msgstr "Reduzir Luminância"

#: src/menus/colors/hot.xml:79(term)
msgid "Reduce Saturation"
msgstr "Reduzir Saturação"

#: src/menus/colors/hot.xml:87(term)
#| msgid "Black point"
msgid "Blacken"
msgstr "Escurecer"

#: src/menus/colors/hot.xml:89(para)
#| msgid ""
#| "<guilabel>Blacken</guilabel>: this changes hot pixels to black."
msgid "This changes hot pixels to black."
msgstr "Isto transforma pixels superaquecidos em preto."

#: src/menus/colors/hot.xml:98(term)
#| msgid "Create a new layer"
msgid "Create new layer"
msgstr "Criar uma nova camada"

#: src/menus/colors/hot.xml:100(para)
msgid ""
"When this option is checked, work is performed on a new layer instead of the"
" active layer."
msgstr ""
"Com esta opção marcada, o trabalho será feito em uma nova camada, em vez de "
"na camada ativa."

