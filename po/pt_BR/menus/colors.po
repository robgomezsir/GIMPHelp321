#: src/menus/colors/hue-chroma.xml:9(title)
msgid "Hue Chroma"
msgstr "Matiz Croma"

#: src/menus/colors/hue-chroma.xml:13(secondary)
#: src/menus/colors/hue-chroma.xml:16(primary)
msgid "Hue-Chroma"
msgstr "Matiz-Croma"

#: src/menus/colors/hue-chroma.xml:19(para)
msgid ""
"The Hue-Chroma filter is another way to modify saturation. Clear "
"explanations about chroma and saturation can be found at <ulink "
"url=\"https://ninedegreesbelow.com/photography/changing-saturation-using-"
"lch-chroma.html\"/> ."
msgstr ""
"O filtro Matiz-Croma é outra forma de modificar saturação. Explicações "
"claras sobre croma e saturação podem ser encontradas em <ulink "
"url=\"https://ninedegreesbelow.com/photography/changing-saturation-using-"
"lch-chroma.html\"/> ."

#: src/menus/colors/hue-chroma.xml:27(para)
#| msgid ""
#| "You can access this command from the image menubar through "
#| "<menuchoice><guimenu>Colors</guimenu><guimenuitem>Hue-"
#| "Chroma…</guimenuitem></menuchoice>."
msgid ""
"You can access this command from the main menu through "
"<menuchoice><guimenu>Colors</guimenu><guimenuitem>Hue-"
"Chroma…</guimenuitem></menuchoice>."
msgstr ""
"Você pode acessar este na barra de menu da imagem em "
"<menuchoice><guimenu>Cores</guimenu><guimenuitem>Matiz-"
"Croma...</guimenuitem></menuchoice>."

#: src/menus/colors/hue-chroma.xml:39(title)
msgid "Hue-Chroma Options"
msgstr "Opções de Matiz-Croma"

#: src/menus/colors/hue-chroma.xml:61(para)
#| msgid ""
#| "The slider and the small arrow buttons allow you to select a hue in the "
#| "color circle (-180°, 180°)."
msgid ""
"The slider and the <guilabel>+</guilabel> and <guilabel>-</guilabel> buttons"
" allow you to select a hue in the color wheel (-180°, 180°)."
msgstr ""
"O controle deslizante e os botões <guilabel>+</guilabel> e "
"<guilabel>-</guilabel> permitem selecionar um matiz no círculo cromático "
"(-180°, 180°)."

#: src/menus/colors/hue-chroma.xml:69(term)
msgid "Chroma"
msgstr "Croma"

#: src/menus/colors/hue-chroma.xml:71(para)
msgid ""
"<quote>Chroma</quote> is the purity of the color. Moving this slider makes "
"colors more or less pure."
msgstr ""
"<quote>Croma</quote> é a pureza da cor. Mover este controle torna as cores "
"mais ou menos puras."

#: src/menus/colors/hue-chroma.xml:80(para)
#| msgid ""
#| "This slider and the small arrow buttons allow you to select a value "
#| "(luminosity): -100, 100."
msgid ""
"This slider and the <guilabel>+</guilabel> and <guilabel>-</guilabel> "
"buttons allow you to select a value (luminosity): -100, 100."
msgstr ""
"Este controle deslizante e os botões <guilabel>+</guilabel> e "
"<guilabel>-</guilabel> permitem selecionar um valor (luminosidade): -100, "
"100."

