msgid "Color Management"
msgstr "Gerenciamento de cores"

#: src/menus/view/view-soft-proof.xml:21(para)
msgid ""
"Enabling <guimenuitem>Proof Colors</guimenuitem> allows you to interpret the"
" colors of this view of your image using a soft-proofing profile that you "
"can set using <link linkend=\"gimp-image-soft-proof-profile-assign\">Soft-"
"Proof Profile</link>."
msgstr ""
"Habilitar <guimenuitem>Prova de cores</guimenuitem> permite interpretar as "
"cores desta exibição da sua imagem usando um perfil de prova virtual que "
"você pode definir em <link linkend=\"gimp-image-soft-proof-profile-"
"assign\">Perfil de prova virtual</link>."

