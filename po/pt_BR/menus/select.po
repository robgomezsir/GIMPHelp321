#| "Rectangle</guimenuitem></menuchoice>."
msgid ""
"You can access this command from the main menu through "
"<menuchoice><guimenu>Select</guimenu><guimenuitem>Rounded "
"Rectangle…</guimenuitem></menuchoice>."
msgstr ""
"Você pode encontrar este comando no menu da janela de imagens, em "
"<menuchoice><guimenu>Selecionar</guimenu><guimenuitem>Retângulo "
"arredondado</guimenuitem></menuchoice>."

#: src/menus/select/rounded-rectangle.xml:65(title)
